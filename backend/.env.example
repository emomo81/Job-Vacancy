# Copy this file to .env for local development
# Never commit .env — it is gitignored

# Server
PORT=4000

# MongoDB Atlas connection string
# Get from: cloud.mongodb.com → your cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rankr

# JWT secrets — use long random strings in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google Gemini AI
# Get from: aistudio.google.com → Get API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL (for CORS) — set to your Vercel URL in production
CLIENT_URL=http://localhost:3000

# Twilio — SMS + WhatsApp notifications
# Get from: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Your Twilio phone number (SMS sender), e.g. +15551234567
TWILIO_FROM_PHONE=+15551234567
# WhatsApp sender — leave as-is for Twilio Sandbox, or use your approved WA number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Gmail — Email notifications (no custom domain needed)
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com/security → App passwords → create one named "Rankr"
# 3. Paste the 16-character password below (NOT your regular Gmail password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Rankr Hiring Team

# Africa's Talking — SMS notifications (preferred over Twilio for SMS)
# Sign up free at: africastalking.com → Sandbox tab → Settings → API Key
# For sandbox (free, sends to AT simulator): AT_USERNAME=sandbox
# For production (real phones):              AT_USERNAME=your_account_username
AT_API_KEY=your_at_api_key_here
AT_USERNAME=sandbox
# Sender ID shown on recipient's phone — must be approved in production (leave empty for sandbox)
AT_SENDER_ID=RANKR
